{
  "manifest_version": 3,
  "name": "MakeMidas: AI Image & Video Generator",
  "short_name": "MakeMidas",
  "version": "0.1.0",
  "description": "Turn any picture or text on the web into AI images and videos with Nano Banana, GPT Image, Veo, Kling and more.",
  "homepage_url": "https://makemidas.com/developers",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "MakeMidas",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "contextMenus",
    "identity",
    "notifications",
    "storage"
  ],
  "host_permissions": ["https://makemidas.com/*"]
}
